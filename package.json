{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --import ./lib/test/dom-setup.ts --test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run lint && git diff --check",
    "test:fsrs": "node --import tsx --test lib/fsrs/algorithm.test.ts",
    "test:mastery": "node --import tsx --test lib/mastery/model.test.ts",
    "test:retrieval": "node --import tsx --test lib/retrieval/index.test.ts",
    "test:learning-path": "node --import tsx --test lib/graph/learning-path.test.ts",
    "electron:build-main": "tsc -p electron/tsconfig.json && mv -f electron/main.js electron/main.mjs && mv -f electron/preload.js electron/preload.mjs",
    "electron:rebuild": "electron-rebuild -f -o better-sqlite3 -m . -e node_modules/electron/dist -t prod -v 43.4.0",
    "electron:dev": "npm run electron:build-main && npm run build && electron electron/main.mjs",
    "electron:alias-sqlite": "node scripts/alias-sqlite.mjs",
    "electron:pack": "npm run build && npm run electron:alias-sqlite && npm run electron:build-main && npm run electron:rebuild && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.23",
    "@ai-sdk/react": "^4.0.55",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "^7.0.52",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "html-to-text": "^10.0.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "motion": "^13.0.0",
    "mupdf": "^1.28.0",
    "next": "16.3.0",
    "puppeteer": "^25.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4",
    "ts-fsrs": "^4.7.1",
    "tsx": "^4.23.9",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.loom.app",
    "productName": "Loom",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/main.mjs",
      "electron/preload.mjs",
      ".next/**",
      "next.config.ts",
      "next-env.d.ts",
      "public/**",
      "package.json",
      "node_modules/**",
      "node_modules/better-sqlite3-90e2652d1716b047/**",
      "!node_modules/**/*.{md,markdown,ts,tsx,map,d.ts,flow,coffee,tsbuildinfo}",
      "!node_modules/**/{test,tests,__tests__,docs,doc,examples,example,coverage,benchmark,benchmarks}/**",
      "!node_modules/**/*.{test,spec}.{js,jsx,ts,tsx}",
      "!node_modules/**/{LICENSE,LICENCE,license,licence,CHANGELOG,CHANGELOG.md,changelog.md,README,README.md,readme.md,*.tarball,*.tgz}",
      "!node_modules/**/{.bin,.cache,.github,.circleci,.vscode,.idea,.nyc_output}/**",
      "!node_modules/**/{yarn.lock,package-lock.json,.editorconfig,.eslintrc*,.prettierrc*,.npmignore,.gitignore,.gitattributes,.travis.yml,appveyor.yml}",
      "!eng.traineddata"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/better-sqlite3/**/build/Release/**",
      "node_modules/better-sqlite3/prebuilds/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "icon": "build/icon.icns"
    },
    "icon": "build/icon.icns"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "better-sqlite3@13.0.3": true,
    "@electron/rebuild@4.2.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
